# Security headers — every route. This is a client-side-routed SPA (see
# CLAUDE.md's SPA Routing rule), so every path from /auth/login to /parent
# to /child ultimately serves the same index.html/404.html shell; a rule
# scoped to only the literal "/" path leaves every other route with no CSP
# at all. https://challenges.cloudflare.com is Turnstile (script + iframe +
# its own verification XHR) used by the login screen's magic-link form.
# api.dicebear.com is in connect-src (not just img-src) because the service
# worker's own CacheFirst runtime-caching fetch() for avatars (vite.config.ts)
# runs under this same CSP — a worker's own fetch() is governed by
# connect-src regardless of what the *page*-level <img> request needs.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://api.dicebear.com https://*.googleusercontent.com; connect-src 'self' https://api.morechard.com https://sap.morechard.com https://eu.posthog.com https://*.ingest.de.sentry.io https://*.ingest.sentry.io https://challenges.cloudflare.com https://api.dicebear.com; frame-src https://js.stripe.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# index.html / SPA shell / 404 fallback — always revalidate so users pick up
# new deployments immediately (headers here layer on top of the /* block
# above; only Cache-Control differs per path).
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/404.html
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed JS/CSS assets — safe to cache long-term (filename changes on each build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
